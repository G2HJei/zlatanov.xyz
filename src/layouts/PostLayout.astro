---
import type { Post } from '../collections';
import Card from '../components/Card.astro';
import Hero from '../components/Hero.astro';
import PostMeta from '../components/PostMeta.astro';
import Prose from '../components/Prose.astro';
import TagList from '../components/TagList.astro';
import { postUrl } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: Post;
  newer: Post | null;
  older: Post | null;
}

const { entry, newer, older } = Astro.props;
const { title, description, date, updated, tags, author, cover } = entry.data;
const minutes = readingTime(entry.body ?? '').text;

const adjacentCard =
  'group block rounded-xl border border-line bg-surface-muted p-5 transition duration-300 hover:border-accent';
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={cover}
  publishedTime={date}
  modifiedTime={updated}
  tags={tags}
  author={author}
>
  <article class="mx-auto max-w-4xl">
    <Hero as="header" title={title}>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-muted">{description}</p>
      <PostMeta
        variant="pills"
        author={author}
        date={date}
        updated={updated}
        readingTime={minutes}
        class="mt-6 justify-center"
      />
      <TagList tags={tags} class="mt-4 justify-center" />
    </Hero>

    <Card as="div">
      <Prose>
        <slot />
      </Prose>
    </Card>

    {(older || newer) && (
      <nav aria-label="Adjacent posts" class="mt-8 grid gap-4 sm:grid-cols-2">
        {older && (
          <a href={postUrl(older.id)} rel="prev" class={adjacentCard}>
            <span class="block font-mono text-xs text-ink-faint">&lt; older</span>
            <span class="mt-1 block font-medium text-ink transition group-hover:text-accent">
              {older.data.title}
            </span>
          </a>
        )}
        {newer && (
          <a
            href={postUrl(newer.id)}
            rel="next"
            class:list={[adjacentCard, 'text-right sm:col-start-2']}
          >
            <span class="block font-mono text-xs text-ink-faint">newer &gt;</span>
            <span class="mt-1 block font-medium text-ink transition group-hover:text-accent">
              {newer.data.title}
            </span>
          </a>
        )}
      </nav>
    )}

    <p class="mt-10 text-center font-mono text-sm">
      <a href="/blog/" class="text-ink-faint transition hover:text-accent">
        $ cd /blog/
      </a>
    </p>
  </article>
</BaseLayout>
