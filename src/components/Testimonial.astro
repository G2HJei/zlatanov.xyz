---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { quote, name, role, company } = Astro.props.testimonial;
const attribution = [role, company].filter(Boolean).join(', ');
---

<figure class="flex h-full flex-col rounded-r-lg border-l-4 border-accent bg-surface-raised px-6 py-5">
  <blockquote class="flex-1 text-lg leading-relaxed text-ink-muted italic">
    <p>“{quote}”</p>
  </blockquote>
  <figcaption class="mt-4 font-mono text-sm text-ink-faint">
    <span class="text-ink">{name}</span>
    {attribution && `, ${attribution}`}
  </figcaption>
</figure>
