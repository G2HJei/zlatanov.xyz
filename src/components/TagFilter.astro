---
/**
 * Filters the blog's post list by tag, in CSS only. Every pill links to an empty marker
 * beside it (`#tag-java`), the rules from `tagFilterCss` hide the posts without that tag
 * while it is the URL fragment, and the pill next to the targeted marker turns solid green;
 * with no marker targeted, `all` is the solid one. The markers are pinned to the top of the
 * viewport, already in view, so following a filter never scrolls the page. Tag chips
 * elsewhere link here through `tagUrl`, filter applied. Posts opt in with a `data-tags`
 * attribute holding their tag slugs.
 */
import type { PostLike } from '../lib/posts';
import { groupByTag, tagFilterCss, tagFilterId } from '../lib/tags';

interface Props {
  posts: PostLike[];
  class?: string;
}

const { posts, class: className } = Astro.props;
const groups = groupByTag(posts);

const pill =
  'inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-4 py-2 font-mono text-sm text-accent transition duration-300 hover:border-accent hover:shadow-[0_0_10px_var(--color-glow)] group-has-target/tag:border-accent group-has-target/tag:bg-accent group-has-target/tag:text-surface';
const count = 'text-xs text-ink-faint group-has-target/tag:text-surface';
const marker = 'fixed top-0 left-0';
---

{groups.length > 0 && (
  <div
    class:list={[
      'flex flex-col items-center gap-4 sm:flex-row sm:items-baseline sm:justify-center',
      className,
    ]}
  >
    <h2
      id="tag-filter-heading"
      class="shrink-0 font-mono text-sm text-ink-faint before:text-accent before:content-['>_']"
    >
      filter by tag
    </h2>
    <ul
      aria-labelledby="tag-filter-heading"
      class="group/filters flex flex-wrap justify-center gap-3 sm:justify-start"
    >
      <li class="group/tag">
        <a
          href="#all"
          class:list={[
            pill,
            'group-not-has-target/filters:border-accent group-not-has-target/filters:bg-accent group-not-has-target/filters:text-surface',
          ]}
        >
          all
          <span class:list={[count, 'group-not-has-target/filters:text-surface']}>
            {posts.length}
          </span>
        </a>
        <span id="all" class={marker}></span>
      </li>
      {groups.map((group) => (
        <li class="group/tag">
          <a href={`#${tagFilterId(group.slug)}`} class={pill}>
            <span class="before:content-['#']">{group.label}</span>
            <span class={count}>{group.count}</span>
          </a>
          <span id={tagFilterId(group.slug)} class={marker}></span>
        </li>
      ))}
    </ul>
    <style is:inline set:html={tagFilterCss(groups.map((group) => group.slug))}></style>
  </div>
)}
