---
import type { Post } from '../collections';
import { postUrl } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import Card from './Card.astro';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

/**
 * One post as a card: green h3 title (the blog page lists posts under a `# posts` h2),
 * mono meta line, description and tags. The whole card links to the post: the tags are
 * links of their own and links cannot nest, so the title link stretches an `::after` over
 * the card and the tag list sits above it. Pointing anywhere but a tag draws a green
 * underline under the title, like the nav links.
 */
interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, tags, author } = post.data;
const minutes = readingTime(post.body ?? '').text;
---

<Card as="article" padding="compact" hover>
  <h3 class="text-2xl leading-snug font-semibold text-accent">
    <a
      href={postUrl(post.id)}
      class="bg-gradient-accent bg-[length:0%_2px] bg-bottom-left bg-no-repeat transition-[background-size,text-shadow] duration-300 after:absolute after:inset-0 after:rounded-lg hover:bg-[length:100%_2px] hover:glow-text focus-visible:bg-[length:100%_2px] focus-visible:glow-text focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-accent"
    >
      {title}
    </a>
  </h3>
  <PostMeta date={date} author={author} readingTime={minutes} class="mt-3" />
  <p class="mt-4 text-ink-muted">{description}</p>
  <TagList tags={tags} class="relative z-10 mt-4 w-fit" />
</Card>
