---
import type { Post } from '../collections';
import { postUrl } from '../lib/posts';
import { readingTime } from '../lib/reading-time';
import Card from './Card.astro';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

/** One post as a card: green title, mono meta line, description and tags. */
interface Props {
  post: Post;
  /** `h3` when the list sits under its own h2 (the blog page), `h2` otherwise. */
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, date, tags, author } = post.data;
const minutes = readingTime(post.body ?? '').text;
---

<Card as="article" padding="compact" hover>
  <Heading class="text-2xl leading-snug font-semibold text-accent">
    <a href={postUrl(post.id)} class="transition hover:glow-text">
      {title}
    </a>
  </Heading>
  <PostMeta date={date} author={author} readingTime={minutes} class="mt-3" />
  <p class="mt-4 text-ink-muted">{description}</p>
  <TagList tags={tags} class="mt-4" />
</Card>
