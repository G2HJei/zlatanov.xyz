---
/**
 * Light/dark switch. The initial theme is applied by the inline script in
 * BaseLayout before first paint; this component only handles user changes.
 */
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Dark mode"
  aria-pressed="false"
  class="inline-flex size-8 items-center justify-center rounded-md text-ink-muted transition-colors hover:bg-surface-muted hover:text-ink"
>
  <!-- moon: shown in light mode -->
  <svg
    class="size-4 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <!-- sun: shown in dark mode -->
  <svg
    class="hidden size-4 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const button = document.getElementById('theme-toggle');
  const media = matchMedia('(prefers-color-scheme: dark)');

  const reflect = () =>
    button?.setAttribute('aria-pressed', String(root.classList.contains('dark')));

  button?.addEventListener('click', () => {
    const dark = root.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
    reflect();
  });

  // Follow the OS while the visitor has not made an explicit choice.
  media.addEventListener('change', (event) => {
    if (localStorage.getItem('theme') === null) {
      root.classList.toggle('dark', event.matches);
      reflect();
    }
  });

  reflect();
</script>
