---
/**
 * Centred page opener under a pulsing green rule, as on the reference site. Pass
 * `title` for a gradient h1 and `subtitle` for a `$ ` prompt line, or fill the slot
 * (the home page puts its slogan here; post pages add their meta).
 */
interface Props {
  title?: string;
  subtitle?: string;
  as?: 'section' | 'header';
  class?: string;
}

const { title, subtitle, as: Tag = 'section', class: className } = Astro.props;
---

<Tag
  class:list={[
    'relative mb-8 py-12 text-center sm:py-12',
    className,
  ]}
>
  {title !== undefined && (
    <h1 class="text-gradient text-4xl leading-[1.15] font-bold sm:text-5xl lg:text-[3.5rem]">
      {title}
    </h1>
  )}
  {subtitle !== undefined && (
    <p class="mt-4 font-mono text-[1.1rem] text-ink-muted before:text-accent before:content-['$_']">
      {subtitle}
    </p>
  )}
  <slot />
</Tag>
