---
import { SITE } from '../lib/site';

const year = new Date().getFullYear();
const links = [
  { href: SITE.social.github, label: 'GitHub', external: true },
  { href: SITE.social.linkedin, label: 'LinkedIn', external: true },
  { href: `mailto:${SITE.email}`, label: 'Email', external: false },
  { href: '/rss.xml', label: 'RSS', external: false },
];
---

<footer class="mt-16 border-t border-line py-12 text-center font-mono text-ink-faint">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-4 px-4 sm:px-8">
    <ul class="flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            rel={link.external ? 'me noopener' : undefined}
            class="transition hover:text-accent"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p>
      © {year} {SITE.name}
    </p>
  </div>
</footer>
