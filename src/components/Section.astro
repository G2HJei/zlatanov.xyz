---
import { tagSlug } from '../lib/tags';

/**
 * Editorial section: heading and lead in the left third, content in the right two
 * thirds, stacked on small screens. The optional `action` slot is a link under the lead.
 */
interface Props {
  id?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { id, title, lead, class: className } = Astro.props;
const headingId = `${id ?? tagSlug(title)}-heading`;
---

<section
  id={id}
  class:list={['scroll-mt-28 border-t border-line py-14 sm:py-16 lg:py-20', className]}
  aria-labelledby={headingId}
>
  <div class="grid gap-y-8 lg:grid-cols-12 lg:gap-x-12">
    <div class="lg:col-span-4">
      <h2 id={headingId} class="text-2xl font-semibold tracking-tight sm:text-3xl">
        {title}
      </h2>
      {lead && <p class="mt-3 text-ink-muted">{lead}</p>}
      {Astro.slots.has('action') && (
        <p class="mt-5 text-sm">
          <slot name="action" />
        </p>
      )}
    </div>
    <div class="lg:col-span-8">
      <slot />
    </div>
  </div>
</section>
