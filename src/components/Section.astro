---
import { tagSlug } from '../lib/tags';

interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  lead?: string;
  class?: string;
}

const { id, eyebrow, title, lead, class: className } = Astro.props;
const headingId = `${id ?? tagSlug(title)}-heading`;
---

<section id={id} class:list={['mt-20 scroll-mt-24', className]} aria-labelledby={headingId}>
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-3xl">
      {eyebrow && <p class="font-mono text-sm text-accent">{eyebrow}</p>}
      <h2 id={headingId} class="mt-1 text-2xl font-semibold tracking-tight sm:text-3xl">
        {title}
      </h2>
      {lead && <p class="mt-3 text-lg text-ink-muted">{lead}</p>}
    </div>
    <slot name="action" />
  </div>
  <div class="mt-8">
    <slot />
  </div>
</section>
