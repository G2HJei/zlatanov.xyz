---
import { formatDate, toIsoDate } from '../lib/dates';

interface Props {
  date: Date;
  updated?: Date;
  author?: string;
  readingTime: string;
  class?: string;
}

const { date, updated, author, readingTime, class: className } = Astro.props;
---

<p
  class:list={[
    'meta flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted',
    className,
  ]}
>
  {author && <span class="font-medium text-ink">{author}</span>}
  <time datetime={toIsoDate(date)}>{formatDate(date)}</time>
  {updated && (
    <span>
      Updated <time datetime={toIsoDate(updated)}>{formatDate(updated)}</time>
    </span>
  )}
  <span>{readingTime}</span>
</p>

<style>
  /* A hairline between items instead of a middle dot. */
  .meta > * + *::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.75em;
    margin-right: 0.75rem;
    background: var(--line);
    vertical-align: -0.05em;
  }
</style>
