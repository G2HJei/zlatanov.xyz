---
/** Date, author and reading time on one mono line with bullet separators. */
import { formatDate, toIsoDate } from '../lib/dates';
import Icon from './Icon.astro';

interface Props {
  date: Date;
  updated?: Date;
  author?: string;
  readingTime: string;
  class?: string;
}

const { date, updated, author, readingTime, class: className } = Astro.props;
---

<p
  class:list={[
    'flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-sm text-ink-faint',
    className,
  ]}
>
  <Icon name="calendar" class="size-4 text-accent" />
  <time datetime={toIsoDate(date)}>{formatDate(date)}</time>
  {updated && (
    <>
      <span aria-hidden="true">•</span>
      <span>
        updated <time datetime={toIsoDate(updated)}>{formatDate(updated)}</time>
      </span>
    </>
  )}
  {author && (
    <>
      <span aria-hidden="true">•</span>
      <span>{author}</span>
    </>
  )}
  <span aria-hidden="true">•</span>
  <span>{readingTime}</span>
</p>
