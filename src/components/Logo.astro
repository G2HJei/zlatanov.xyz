---
/**
 * The brand mark from favicon.svg without its tile, inlined so the prompt follows the
 * current text colour. The cursor stays ink, as in the mark.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg class={className} viewBox="8 8 48 48" aria-hidden="true">
  <path
    d="M14 20 L26 32 L14 44"
    fill="none"
    stroke="currentColor"
    stroke-width="5.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <rect x="31" y="40" width="20" height="5.5" class="fill-ink"></rect>
</svg>
