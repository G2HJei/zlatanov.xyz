---
import { SITE } from '../lib/site';
import ButtonLink from './ButtonLink.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Have a project in mind?',
  text = 'Tell me about your team and what is slowing it down. A short conversation is enough to see whether I can help.',
} = Astro.props;
---

<section class="mt-24 rounded-xl border border-line bg-surface-muted px-6 py-10 sm:px-10">
  <h2 class="text-2xl font-semibold tracking-tight">{title}</h2>
  <p class="mt-3 max-w-2xl text-ink-muted">{text}</p>
  <div class="mt-6 flex flex-wrap gap-3">
    <ButtonLink href="/contact/">Get in touch</ButtonLink>
    <ButtonLink href={`mailto:${SITE.email}`} variant="secondary">
      {SITE.email}
    </ButtonLink>
  </div>
</section>
