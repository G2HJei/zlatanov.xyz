---
import { SITE } from '../lib/site';
import ButtonLink from './ButtonLink.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Have a project in mind?',
  text = 'Tell me about your team and what is slowing it down. A short conversation is enough to see whether I can help.',
} = Astro.props;
---

<section class="border-t border-line py-16 sm:py-20 lg:py-24" aria-labelledby="cta-heading">
  <div class="grid gap-y-6 lg:grid-cols-12 lg:gap-x-12">
    <h2 id="cta-heading" class="text-3xl font-semibold tracking-tight sm:text-4xl lg:col-span-5">
      {title}
    </h2>
    <div class="lg:col-span-6 lg:col-start-7">
      <p class="text-lg text-ink-muted">{text}</p>
      <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3">
        <ButtonLink href="/contact/">Get in touch</ButtonLink>
        <a href={`mailto:${SITE.email}`} class="text-link">
          {SITE.email}
        </a>
      </div>
    </div>
  </div>
</section>
