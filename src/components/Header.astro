---
/**
 * Sticky, translucent header: on the left the logo as a shell prompt, `> zlatanov`
 * with a blinking block cursor, and the subtitle beside it from `sm` up; on the right
 * the two-item navigation. Hovering a link draws a green underline; the current page
 * keeps it.
 */
import { nav } from '../data/nav';
import { SITE } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur-[10px]">
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-4 py-4 sm:px-8">
    <a
      href="/"
      class="flex items-center gap-2 font-mono text-[1.2rem] font-bold text-ink transition hover:text-accent"
    >
      <span aria-hidden="true" class="text-2xl text-accent">
        &gt;
      </span>
      <span>{SITE.logo}</span>
      <span aria-hidden="true" class="h-[1.2em] w-[0.55em] animate-blink bg-accent"></span>
      <span class="ml-2 hidden border-l border-line pl-3 text-xs font-normal tracking-wide text-ink-muted sm:inline">
        {SITE.logoSubtitle}
      </span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-8">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="relative inline-block py-2 font-medium text-ink-muted transition after:absolute after:bottom-0 after:left-0 after:h-0.5 after:w-0 after:bg-gradient-accent after:transition-[width] after:duration-300 hover:text-accent hover:glow-text hover:after:w-full aria-[current=page]:text-ink aria-[current=page]:after:w-full"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
