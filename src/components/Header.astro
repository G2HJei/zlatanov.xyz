---
import { SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/services/', label: 'Services' },
  { href: '/case-studies/', label: 'Work' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="border-b border-line">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-4 sm:px-6">
    <a href="/" class="font-semibold tracking-tight hover:text-accent">
      {SITE.name}
    </a>
    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
        {nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'transition-colors hover:text-accent',
                isActive(item.href) ? 'font-medium text-accent' : 'text-ink-muted',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="flex items-center">
          <ThemeToggle />
        </li>
      </ul>
    </nav>
  </div>
</header>
