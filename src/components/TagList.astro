---
import { tagSlug, tagUrl } from '../lib/tags';

/** Tags as `#hashtag` chips on a translucent green field. */
interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;

// The schema rejects tags without a slug; the filter keeps the markup honest regardless.
const linked = tags.map((tag) => ({ tag, slug: tagSlug(tag) })).filter(({ slug }) => slug !== '');
---

{linked.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', className]} aria-label="Tags">
    {linked.map(({ tag, slug }) => (
      <li>
        <a
          href={tagUrl(slug)}
          class="inline-block rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent transition duration-300 before:content-['#'] hover:border-accent hover:bg-accent/20 hover:shadow-[0_0_10px_var(--color-glow)]"
        >
          {tag}
        </a>
      </li>
    ))}
  </ul>
)}
