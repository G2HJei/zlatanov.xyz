---
import { tagSlug, tagUrl } from '../lib/tags';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{tags.length > 0 && (
  <ul class:list={['flex flex-wrap gap-2', className]} aria-label="Tags">
    {tags.map((tag) => (
      <li>
        <a
          href={tagUrl(tagSlug(tag))}
          class="inline-block rounded-full border border-line px-2.5 py-0.5 text-xs text-ink-muted transition-colors hover:border-accent hover:text-accent"
        >
          {tag}
        </a>
      </li>
    ))}
  </ul>
)}
