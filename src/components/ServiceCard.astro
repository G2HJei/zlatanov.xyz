---
import type { Service } from '../data/services';

/** One row in the services list: title on the left, tagline on the right. */
interface Props {
  service: Service;
}

const { service } = Astro.props;
const href = `/services/#${service.slug}`;
---

<article class="grid gap-y-1.5 sm:grid-cols-[15rem_1fr] sm:gap-x-8">
  <h3 class="text-lg font-semibold tracking-tight">
    <a href={href} class="transition-colors hover:text-accent">
      {service.title}
    </a>
  </h3>
  <p class="text-ink-muted">{service.tagline}</p>
</article>
