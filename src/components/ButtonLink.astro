---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const variants = {
  primary: 'bg-ink text-surface hover:bg-ink/85',
  secondary:
    'border border-line bg-surface text-ink hover:border-ink-muted/50 hover:bg-surface-muted',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-lg px-4.5 py-2.5 text-[0.95rem] font-medium transition-colors',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
