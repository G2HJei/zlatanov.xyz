---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;

const variants = {
  primary: 'bg-accent text-accent-ink hover:bg-accent-hover',
  secondary: 'border border-line hover:border-accent hover:text-accent',
};
---

<a
  href={href}
  class:list={[
    'inline-block rounded-md px-5 py-2.5 font-medium transition-colors',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
