---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import { getCaseStudies } from '../../collections';
import CTA from '../../components/CTA.astro';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const studies = await getCaseStudies();
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { title, client, period, stack, summary, outcome } = entry.data;
const { Content } = await render(entry);
const meta = [client, period].filter(Boolean).join(', ');
---

<BaseLayout title={title} description={summary} type="article">
  <article class="mx-auto max-w-2xl py-10 sm:py-16">
    <header class="mb-10 sm:mb-12">
      <p class="mb-5 text-sm">
        <a href="/case-studies/" class="text-ink-muted transition-colors hover:text-ink">
          Work
        </a>
      </p>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      {meta && <p class="mt-4 text-sm text-ink-muted">{meta}</p>}
      <p class="mt-5 text-lg text-ink-muted sm:text-xl">{summary}</p>
      {stack.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack">
          {stack.map((item) => (
            <li class="rounded-full bg-surface-muted px-2.5 py-1 text-xs font-medium text-ink-muted">
              {item}
            </li>
          ))}
        </ul>
      )}
    </header>

    <Prose>
      <Content />
    </Prose>

    <aside class="mt-12 border-l-2 border-accent pl-5">
      <p class="font-semibold">Outcome</p>
      <p class="mt-2 text-ink-muted">{outcome}</p>
    </aside>
  </article>

  <CTA />
</BaseLayout>
