---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import { getCaseStudies } from '../../collections';
import Card from '../../components/Card.astro';
import Hero from '../../components/Hero.astro';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const studies = await getCaseStudies();
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { title, client, period, stack, summary, outcome } = entry.data;
const { Content } = await render(entry);
const meta = [client, period].filter((item) => item !== undefined);
---

<BaseLayout title={title} description={summary} type="article">
  <article class="mx-auto max-w-4xl">
    <Hero as="header" title={title}>
      <p class="mx-auto mt-5 max-w-2xl text-lg text-ink-muted">{summary}</p>
      {meta.length > 0 && (
        <ul class="mt-6 flex flex-wrap justify-center gap-3 font-mono text-sm text-ink-faint">
          {meta.map((item) => (
            <li class="inline-flex items-center rounded-full border border-line bg-surface-raised px-4 py-2">
              {item}
            </li>
          ))}
        </ul>
      )}
      {stack.length > 0 && (
        <ul class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Stack">
          {stack.map((item) => (
            <li class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 font-mono text-xs text-accent">
              {item}
            </li>
          ))}
        </ul>
      )}
    </Hero>

    <Card as="div">
      <Prose>
        <Content />
      </Prose>
      <aside class="mt-10 rounded-r-lg border-l-4 border-accent bg-surface-raised px-6 py-5">
        <p class="font-mono text-sm text-ink-faint before:text-accent before:content-['>_']">
          outcome
        </p>
        <p class="mt-2 text-ink">{outcome}</p>
      </aside>
    </Card>

    <p class="mt-10 text-center font-mono text-sm">
      <a href="/blog/#work" class="text-ink-faint transition hover:text-accent">
        $ cd /blog/#work
      </a>
    </p>
  </article>
</BaseLayout>
