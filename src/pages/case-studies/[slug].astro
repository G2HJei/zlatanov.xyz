---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import { getCaseStudies } from '../../collections';
import CTA from '../../components/CTA.astro';
import Prose from '../../components/Prose.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const studies = await getCaseStudies();
  return studies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { entry } = Astro.props;
const { title, client, period, stack, summary, outcome } = entry.data;
const { Content } = await render(entry);
const meta = [client, period].filter(Boolean).join(' · ');
---

<BaseLayout title={title} description={summary} type="article">
  <article class="mx-auto max-w-3xl">
    <header class="mb-10">
      <p class="text-sm text-ink-muted">
        <a href="/case-studies/" class="hover:text-accent">
          Work
        </a>
      </p>
      <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
      {meta && <p class="mt-3 font-mono text-sm text-ink-muted">{meta}</p>}
      <p class="mt-4 text-lg text-ink-muted">{summary}</p>
      {stack.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="Stack">
          {stack.map((item) => (
            <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-ink-muted">
              {item}
            </li>
          ))}
        </ul>
      )}
    </header>

    <Prose>
      <Content />
    </Prose>

    <aside class="mt-12 rounded-lg border-l-4 border-accent bg-surface-muted p-6">
      <p class="font-semibold">Outcome</p>
      <p class="mt-2 text-ink-muted">{outcome}</p>
    </aside>
  </article>

  <CTA />
</BaseLayout>
