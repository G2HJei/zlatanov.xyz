---
import { getCaseStudies } from '../../collections';
import CTA from '../../components/CTA.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import Testimonial from '../../components/Testimonial.astro';
import { testimonials } from '../../data/testimonials';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { caseStudyUrl } from '../../lib/posts';

const studies = await getCaseStudies();
---

<BaseLayout
  title="Work"
  description="Selected consulting engagements and what they changed for the teams involved."
>
  <div class="max-w-3xl pb-14 sm:pb-16 lg:pb-20">
    <PageHeader
      title="Work"
      lead="Selected engagements, described in terms of the problem, the approach and what changed for the team."
    />

    {studies.length === 0 ? (
      <p class="max-w-2xl border-t border-line pt-8 text-ink-muted">
        Detailed write-ups are on their way. In the meantime I am happy to walk you through relevant
        engagements in a call.
      </p>
    ) : (
      <ul class="divide-y divide-line border-t border-line">
        {studies.map((study) => {
          const meta = [study.data.client, study.data.period].filter(Boolean).join(', ');
          return (
            <li class="py-8">
              <article>
                {meta && <p class="text-sm text-ink-muted">{meta}</p>}
                <h2 class="mt-2 text-2xl font-semibold tracking-tight">
                  <a href={caseStudyUrl(study.id)} class="transition-colors hover:text-accent">
                    {study.data.title}
                  </a>
                </h2>
                <p class="mt-3 text-ink-muted">{study.data.summary}</p>
                <p class="mt-4 border-l-2 border-accent pl-4">{study.data.outcome}</p>
                {study.data.stack.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-2" aria-label="Stack">
                    {study.data.stack.map((item) => (
                      <li class="rounded-full bg-surface-muted px-2.5 py-1 text-xs font-medium text-ink-muted">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>

  {testimonials.length > 0 && (
    <Section title="What clients say">
      <ul class="grid gap-8 md:grid-cols-2">
        {testimonials.map((testimonial) => (
          <li>
            <Testimonial testimonial={testimonial} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CTA title="Sound familiar?" />
</BaseLayout>
