---
import { getCaseStudies } from '../../collections';
import { caseStudyUrl } from '../../lib/posts';
import CTA from '../../components/CTA.astro';
import Section from '../../components/Section.astro';
import Testimonial from '../../components/Testimonial.astro';
import { testimonials } from '../../data/testimonials';
import BaseLayout from '../../layouts/BaseLayout.astro';

const studies = await getCaseStudies();
---

<BaseLayout
  title="Work"
  description="Selected consulting engagements and what they changed for the teams involved."
>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Work</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Selected engagements, described in terms of the problem, the approach and what changed for the
      team.
    </p>

    {studies.length === 0 ? (
      <p class="mt-12 rounded-lg border border-dashed border-line p-8 text-ink-muted">
        Detailed write-ups are on their way. In the meantime I am happy to walk you through relevant
        engagements in a call.
      </p>
    ) : (
      <ul class="mt-12 divide-y divide-line">
        {studies.map((study) => {
          const meta = [study.data.client, study.data.period].filter(Boolean).join(' · ');
          return (
            <li class="py-8 first:pt-0 last:pb-0">
              <article>
                {meta && <p class="font-mono text-sm text-ink-muted">{meta}</p>}
                <h2 class="mt-1 text-2xl font-semibold tracking-tight">
                  <a href={caseStudyUrl(study.id)} class="transition-colors hover:text-accent">
                    {study.data.title}
                  </a>
                </h2>
                <p class="mt-3 text-ink-muted">{study.data.summary}</p>
                <p class="mt-3">
                  <span class="font-semibold">Outcome:</span> {study.data.outcome}
                </p>
                {study.data.stack.length > 0 && (
                  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
                    {study.data.stack.map((item) => (
                      <li class="rounded-full border border-line px-2.5 py-0.5 text-xs text-ink-muted">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </article>
            </li>
          );
        })}
      </ul>
    )}
  </div>

  {testimonials.length > 0 && (
    <Section title="What clients say">
      <ul class="grid gap-6 md:grid-cols-2">
        {testimonials.map((testimonial) => (
          <li>
            <Testimonial testimonial={testimonial} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CTA title="Sound familiar?" />
</BaseLayout>
