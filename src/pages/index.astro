---
import '../styles/home.css';

import Portrait from '../assets/portrait.svg';
import ButtonLink from '../components/ButtonLink.astro';
import HomeHero from '../components/HomeHero.astro';
import Icon from '../components/Icon.astro';
import SocialLink from '../components/SocialLink.astro';
import Stage from '../components/Stage.astro';
import Testimonial from '../components/Testimonial.astro';
import { principles } from '../data/principles';
import { profile } from '../data/profile';
import { services } from '../data/services';
import { testimonials } from '../data/testimonials';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const { intro } = profile;

/** Listed under the portrait; email keeps its own button beside the call to action. */
const socials = [
  { href: SITE.social.linkedin, label: 'LinkedIn', icon: 'linkedin', external: true },
  { href: SITE.social.github, label: 'GitHub', icon: 'github', external: true },
  { href: '/rss.xml', label: 'RSS', icon: 'rss', external: false },
] as const;

/** The drums descend into the mine: each a step deeper (`home.css`) and a shade darker, the
    last still above 4.5:1 on the card. */
const drumShades = ['text-ink-muted', 'text-ink-muted/85', 'text-ink-muted/70'];
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <!-- The page is a pipeline: the hero's wire runs on down the left edge of every stage. -->
  <div class="home flex flex-col gap-(--gap)">
    <HomeHero />

    <Stage id="about" kind="dig">
      <h2 class="hook text-gradient text-3xl leading-tight font-bold sm:text-4xl">
        <span class="sm:block">{intro.hook[0]}</span> <span class="sm:block">{intro.hook[1]}</span>
      </h2>
      <p class="mt-4 font-mono text-[1.1rem] text-ink-muted before:text-accent before:content-['$_']">
        {intro.subtitle}
      </p>

      <p class="mt-10 text-[1.05rem] leading-[1.7] text-ink-muted">
        {intro.moria}
        <br />
        {intro.drumsLead}
      </p>
      <ul class="drums mt-5 space-y-2 font-mono text-[0.95rem]">
        {intro.drums.map((drum, index) => (
          <li class:list={['drum', drumShades[index]]} style={`--step: ${index}`}>
            {drum}
          </li>
        ))}
      </ul>

      <p class="mt-10 text-[1.1rem] font-semibold text-ink">{intro.wayThrough}</p>
      <ul class="lamps mt-6 grid gap-6 sm:grid-cols-3 sm:gap-8">
        {intro.practices.map((practice, index) => (
          <li class="lamp" style={`--i: ${index}`}>
            <h3 class="font-mono text-lg font-semibold text-ink before:text-accent before:content-['>_']">
              {practice.name}
            </h3>
            <p class="mt-2 leading-[1.7] text-ink-muted">{practice.text}</p>
          </li>
        ))}
      </ul>

      <div class="branch mt-12 flex flex-col-reverse gap-6 pt-10 sm:flex-row sm:items-start sm:gap-8">
        <div class="flex-1">
          <div class="space-y-4 leading-[1.7] text-ink-muted">
            {intro.introduction.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          <p class="mt-6 font-semibold text-ink">{intro.cta}</p>
          <div class="mt-4">
            <ButtonLink href={`mailto:${SITE.email}`} class="charge">
              <Icon name="mail" class="size-5" />
              {SITE.email}
            </ButtonLink>
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-6 sm:flex-col">
          <div class="portrait size-24 shrink-0 rounded-full border-[3px] border-accent shadow-[0_0_24px_var(--color-glow)]">
            <div class="portrait-plate size-full overflow-hidden rounded-full bg-surface-raised text-accent">
              <Portrait class="size-full" aria-hidden="true" />
            </div>
          </div>
          <ul class="socials flex flex-col gap-3" aria-label="Elsewhere">
            {socials.map((social) => (
              <li>
                <SocialLink href={social.href} external={social.external} class="w-full">
                  <Icon name={social.icon} class="size-4" />
                  {social.label}
                </SocialLink>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Stage>

    <Stage id="services" title="services" kind="branch">
      <p class="text-ink-muted">
        Three ways teams bring me in. Every engagement starts with a short conversation about what
        is slowing you down, and ends with your team owning the result.
      </p>
      <div class="mt-8">
        {services.map((service, index) => (
          <article
            id={service.slug}
            class:list={['scroll-mt-28 py-8 first:pt-0 last:pb-0', index > 0 && 'branch']}
          >
            <h3 class="font-mono text-xl font-semibold text-ink before:text-accent before:content-['>_']">
              {service.title}
            </h3>
            <p class="mt-2 text-ink-muted">{service.tagline}</p>
            <div class="mt-6 grid gap-8 sm:grid-cols-2">
              <div>
                <h4 class="font-mono text-sm text-ink-faint">you get</h4>
                <ul class="mt-3 space-y-2 text-ink-muted">
                  {service.outcomes.map((outcome) => (
                    <li class="test flex gap-3">
                      <Icon name="check" class="mt-1.5 size-4 shrink-0 text-accent" />
                      <span>{outcome}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <h4 class="font-mono text-sm text-ink-faint">a good fit if</h4>
                <ul class="mt-3 space-y-2 text-ink-muted">
                  {service.goodFitIf.map((reason) => (
                    <li class="test flex gap-3">
                      <Icon name="check" class="mt-1.5 size-4 shrink-0 text-accent" />
                      <span>{reason}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
            <p class="mt-6 text-sm text-ink-muted">
              <span class="font-mono text-ink-faint">engagement:</span> {service.engagement}
            </p>
          </article>
        ))}
      </div>
    </Stage>

    <Stage id="how-i-work" title="how I work" kind="branch">
      <dl class="contexts grid gap-4 sm:grid-cols-2">
        {principles.map((principle) => (
          <div class="context p-5">
            <dt class="font-mono font-semibold text-accent">{principle.title}</dt>
            <dd class="mt-2 text-ink-muted">{principle.text}</dd>
          </div>
        ))}
      </dl>
    </Stage>

    {testimonials.length > 0 && (
      <Stage id="testimonials" title="what clients say" kind="branch">
        <ul class="grid gap-6 md:grid-cols-2">
          {testimonials.map((testimonial) => (
            <li>
              <Testimonial testimonial={testimonial} />
            </li>
          ))}
        </ul>
      </Stage>
    )}

    <Stage id="contact" title="contact" kind="crt" class="text-center">
      <p class="mx-auto max-w-2xl text-[1.1rem] text-ink-muted">
        The quickest way to reach me is email. Tell me a little about your team and what you are
        trying to change, and I will get back to you.
      </p>
      <div class="actions mt-8 flex flex-wrap justify-center gap-4">
        <ButtonLink href={`mailto:${SITE.email}`} class="charge">
          <Icon name="mail" class="size-5" />
          {SITE.email}
        </ButtonLink>
        <ButtonLink href={SITE.social.linkedin} variant="dim" external class="charge">
          <Icon name="linkedin" class="size-5" />
          LinkedIn
        </ButtonLink>
      </div>
      <div class="tips mx-auto mt-10 max-w-2xl p-5 text-left">
        <h3 class="font-mono text-sm text-ink-faint">what helps me reply well</h3>
        <ul class="mt-3 space-y-2 text-ink-muted">
          {profile.contactTips.map((tip) => (
            <li class="test flex gap-3">
              <Icon name="check" class="mt-1.5 size-4 shrink-0 text-accent" />
              <span>{tip}</span>
            </li>
          ))}
        </ul>
      </div>
    </Stage>
  </div>
</BaseLayout>

<script>
  /*
   * The pipeline never runs backwards. Its scroll-driven animations (`home.css`) follow the
   * scroll both ways; this holds them at the furthest point the reader has reached, so what
   * has been built stays built while they scroll back up, and the run picks up where it
   * stopped once they come back down past that point. At the bottom of the page the run is
   * over: every animation stops on its last frame for good, the page is static, and `done`
   * takes the wire away.
   */
  const home = document.querySelector<HTMLElement>('.home');

  if (home) {
    /** On a scroll or view timeline rather than the clock, which runs the hero on load. */
    const scrollDriven = () =>
      document.getAnimations().filter((animation) => animation.timeline !== document.timeline);

    /** Setting the time completes the pause at once; a bare `pause()` lands a frame later,
        wherever the scroll has moved the animation by then. */
    const pauseAt = (animation: Animation, time: CSSNumberish | null | undefined) => {
      if (time === null || time === undefined) return;
      animation.pause();
      animation.currentTime = time;
    };

    let furthest = scrollY;
    let state: 'running' | 'holding' | 'done' = 'running';

    const hold = () => {
      state = 'holding';
      for (const animation of scrollDriven()) {
        if (animation.playState === 'paused') continue;
        if (animation.startTime === null) {
          // Resumed but not yet caught up with the scroll, it would hold its old place: let
          // it arrive first.
          animation.ready.then(
            () => {
              if (state === 'holding') pauseAt(animation, animation.currentTime);
            },
            () => {},
          );
        } else {
          pauseAt(animation, animation.currentTime);
        }
      }
    };

    const resume = () => {
      state = 'running';
      for (const animation of scrollDriven()) {
        if (animation.playState === 'paused') animation.play();
      }
    };

    // In a scroll event the animations still show the last frame drawn, from before the
    // scroll moved: turning back holds them exactly there.
    const onScroll = () => {
      if (scrollY < furthest) {
        if (state === 'running') hold();
        return;
      }
      furthest = scrollY;
      if (scrollY >= document.documentElement.scrollHeight - innerHeight - 1) finish();
      else if (state === 'holding') resume();
    };

    // Hold whenever the scroll comes to rest too, a frame later, once everything has caught
    // up with it: turning back from a standstill then can't show a frame of it running
    // backwards, which the compositor would draw before the scroll event arrived.
    const onScrollEnd = () => {
      const stoppedAt = scrollY;
      requestAnimationFrame(() => {
        if (state === 'running' && scrollY === stoppedAt) hold();
      });
    };

    /** At the bottom of the page everything has been built; it ends on the last frames. */
    const finish = () => {
      state = 'done';
      removeEventListener('scroll', onScroll);
      removeEventListener('scrollend', onScrollEnd);
      for (const animation of scrollDriven()) {
        pauseAt(animation, animation.effect?.getComputedTiming().endTime);
      }
      home.classList.add('done');
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('scrollend', onScrollEnd);
    onScroll();
  }
</script>
