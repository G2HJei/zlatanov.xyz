---
import { getPublishedPosts } from '../collections';
import PostCard from '../components/PostCard.astro';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const latest = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout description={SITE.description}>
  <section class="mx-auto max-w-3xl py-8 sm:py-16">
    <p class="font-mono text-sm text-accent">Independent Java consultant</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      Ship Java systems you can change with confidence.
    </h1>
    <p class="mt-6 text-lg text-ink-muted sm:text-xl">
      I help teams deliver faster and safer with test-driven development, domain-driven design and
      CI/CD that make every commit releasable.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/contact/"
        class="inline-block rounded-md bg-accent px-5 py-2.5 font-medium text-accent-ink transition-colors hover:bg-accent-hover"
      >
        Book a conversation
      </a>
      <a
        href="/blog/"
        class="inline-block rounded-md border border-line px-5 py-2.5 font-medium transition-colors hover:border-accent hover:text-accent"
      >
        Read the blog
      </a>
    </div>
  </section>

  <section class="mt-16" aria-labelledby="services-heading">
    <h2 id="services-heading" class="text-2xl font-semibold tracking-tight">
      How I can help
    </h2>
    <ul class="mt-8 grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <li class="rounded-lg border border-line p-6">
          <h3 class="text-lg font-semibold">
            <a href={`/services/#${service.slug}`} class="hover:text-accent">
              {service.title}
            </a>
          </h3>
          <p class="mt-2 text-ink-muted">{service.tagline}</p>
        </li>
      ))}
    </ul>
  </section>

  {latest.length > 0 && (
    <section class="mt-20" aria-labelledby="latest-heading">
      <div class="flex items-baseline justify-between">
        <h2 id="latest-heading" class="text-2xl font-semibold tracking-tight">
          Latest writing
        </h2>
        <a href="/blog/" class="text-sm text-accent hover:underline">
          All posts →
        </a>
      </div>
      <ul class="mt-8 divide-y divide-line">
        {latest.map((post) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
