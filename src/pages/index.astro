---
import { getPublishedPosts } from '../collections';
import ButtonLink from '../components/ButtonLink.astro';
import CTA from '../components/CTA.astro';
import Pipeline from '../components/Pipeline.astro';
import PostCard from '../components/PostCard.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { principles } from '../data/principles';
import { services } from '../data/services';
import { testimonials } from '../data/testimonials';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const latest = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="pt-12 pb-16 sm:pt-20 sm:pb-24" aria-labelledby="hero-heading">
    <h1
      id="hero-heading"
      class="max-w-4xl text-[2.5rem] leading-[1.02] font-semibold tracking-display sm:text-6xl lg:text-7xl"
    >
      Ship Java systems you can change with confidence.
    </h1>
    <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-muted sm:text-xl">
      I help teams deliver faster and safer with test-driven development, domain-driven design and
      CI/CD that make every commit releasable.
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3">
      <ButtonLink href="/contact/">Book a conversation</ButtonLink>
      <ButtonLink href="/blog/" variant="secondary">
        Read the blog
      </ButtonLink>
    </div>
    <Pipeline class="mt-16 sm:mt-24" />
  </section>

  <Section
    title="How I can help"
    lead="Three ways teams usually bring me in. Most engagements combine two of them."
  >
    <a slot="action" href="/services/" class="text-link">
      All services
    </a>
    <ul class="divide-y divide-line">
      {services.map((service) => (
        <li class="py-6 first:pt-0 last:pb-0">
          <ServiceCard service={service} />
        </li>
      ))}
    </ul>
  </Section>

  <Section title="How I work">
    <dl class="grid gap-x-8 gap-y-8 sm:grid-cols-2">
      {principles.map((principle) => (
        <div class="border-t border-line pt-4">
          <dt class="font-semibold">{principle.title}</dt>
          <dd class="mt-2 text-ink-muted">{principle.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {testimonials.length > 0 && (
    <Section title="What clients say">
      <ul class="grid gap-8 md:grid-cols-2">
        {testimonials.map((testimonial) => (
          <li>
            <Testimonial testimonial={testimonial} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  {latest.length > 0 && (
    <Section title="Latest writing">
      <a slot="action" href="/blog/" class="text-link">
        All posts
      </a>
      <ul class="divide-y divide-line">
        {latest.map((post) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CTA />
</BaseLayout>
