---
import { getPublishedPosts } from '../collections';
import ButtonLink from '../components/ButtonLink.astro';
import CTA from '../components/CTA.astro';
import PostCard from '../components/PostCard.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonial from '../components/Testimonial.astro';
import { principles } from '../data/principles';
import { services } from '../data/services';
import { testimonials } from '../data/testimonials';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const latest = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout title={SITE.title} description={SITE.description}>
  <section class="mx-auto max-w-3xl py-8 sm:py-16">
    <p class="font-mono text-sm text-accent">Independent Java consultant</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
      Ship Java systems you can change with confidence.
    </h1>
    <p class="mt-6 text-lg text-ink-muted sm:text-xl">
      I help teams deliver faster and safer with test-driven development, domain-driven design and
      CI/CD that make every commit releasable.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href="/contact/">Book a conversation</ButtonLink>
      <ButtonLink href="/blog/" variant="secondary">
        Read the blog
      </ButtonLink>
    </div>
  </section>

  <Section
    title="How I can help"
    lead="Three ways teams usually bring me in. Most engagements combine two of them."
  >
    <ul class="grid gap-6 md:grid-cols-3">
      {services.map((service) => (
        <li>
          <ServiceCard service={service} />
        </li>
      ))}
    </ul>
    <p class="mt-6 text-sm">
      <a href="/services/" class="font-medium text-accent hover:underline">
        All services →
      </a>
    </p>
  </Section>

  <Section title="How I work">
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {principles.map((principle) => (
        <div>
          <dt class="font-semibold">{principle.title}</dt>
          <dd class="mt-2 text-ink-muted">{principle.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  {testimonials.length > 0 && (
    <Section title="What clients say">
      <ul class="grid gap-6 md:grid-cols-2">
        {testimonials.map((testimonial) => (
          <li>
            <Testimonial testimonial={testimonial} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  {latest.length > 0 && (
    <Section title="Latest writing">
      <a slot="action" href="/blog/" class="text-sm font-medium text-accent hover:underline">
        All posts →
      </a>
      <ul class="divide-y divide-line">
        {latest.map((post) => (
          <li class="py-6 first:pt-0 last:pb-0">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    </Section>
  )}

  <CTA />
</BaseLayout>
