---
import CTA from '../components/CTA.astro';
import Section from '../components/Section.astro';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Services"
  description="Java and Spring delivery, TDD and DDD coaching, and CI/CD engineering for teams that want to ship with confidence."
>
  <header class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">Services</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Three ways teams bring me in. Every engagement starts with a short conversation about what is
      slowing you down, and ends with your team owning the result.
    </p>
    <nav aria-label="On this page" class="mt-6 flex flex-wrap gap-2 text-sm">
      {services.map((service) => (
        <a
          href={`#${service.slug}`}
          class="rounded-full border border-line px-3 py-1 transition-colors hover:border-accent hover:text-accent"
        >
          {service.title}
        </a>
      ))}
    </nav>
  </header>

  {services.map((service, index) => (
    <Section
      id={service.slug}
      eyebrow={`0${index + 1}`}
      title={service.title}
      lead={service.tagline}
    >
      <div class="grid gap-10 md:grid-cols-2">
        <div>
          <h3 class="font-semibold">You get</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {service.outcomes.map((outcome) => (
              <li class="flex gap-3">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{outcome}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-semibold">A good fit if</h3>
          <ul class="mt-3 space-y-2 text-ink-muted">
            {service.goodFitIf.map((reason) => (
              <li class="flex gap-3">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
                <span>{reason}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="mt-8 text-ink-muted">
        <span class="font-semibold text-ink">Engagement:</span> {service.engagement}
      </p>
    </Section>
  ))}

  <CTA />
</BaseLayout>
