---
import ButtonLink from '../components/ButtonLink.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for does not exist.">
  <div class="py-16 sm:py-24">
    <p class="text-sm text-ink-muted">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="mt-5 max-w-xl text-lg text-ink-muted">
      The page you were looking for has moved or never existed.
    </p>
    <div class="mt-8">
      <ButtonLink href="/">Back to the home page</ButtonLink>
    </div>
  </div>
</BaseLayout>
