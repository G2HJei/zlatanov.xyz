---
import { getPublishedPosts } from '../../collections';
import PageHeader from '../../components/PageHeader.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Notes on Java and Spring, test-driven development, domain-driven design and CI/CD, written from consulting engagements."
>
  <div class="max-w-3xl pb-16 sm:pb-24">
    <PageHeader title="Blog">
      <p class="mt-5 max-w-2xl text-lg text-ink-muted sm:text-xl">
        Practical notes on Java, TDD, DDD and CI/CD. Browse by{' '}
        <a href="/blog/tags/" class="text-link">
          tag
        </a>{' '}
        or subscribe via{' '}
        <a href="/rss.xml" class="text-link">
          RSS
        </a>
        .
      </p>
    </PageHeader>

    {posts.length === 0 ? (
      <p class="text-ink-muted">No posts yet.</p>
    ) : (
      <ul class="divide-y divide-line border-t border-line">
        {posts.map((post) => (
          <li class="py-8">
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
