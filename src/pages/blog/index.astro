---
import { getPublishedPosts } from '../../collections';
import ButtonLink from '../../components/ButtonLink.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagSlug } from '../../lib/tags';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Notes on Java and Spring, test-driven development, domain-driven design and CI/CD, written from consulting engagements."
>
  <Hero title="Blog" subtitle="notes on Java, TDD, DDD and CI/CD">
    <TagFilter posts={posts} class="mt-10" />
  </Hero>

  <section id="posts" aria-labelledby="posts-heading">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <h2
        id="posts-heading"
        class="font-mono text-2xl font-semibold text-accent before:text-ink-faint before:content-['#_']"
      >
        posts
      </h2>
      <ButtonLink href="/rss.xml" size="compact">
        <Icon name="rss" class="size-4" />
        RSS feed
      </ButtonLink>
    </div>
    {posts.length === 0 ? (
      <p class="font-mono text-ink-faint">No posts yet.</p>
    ) : (
      <ul class="grid gap-8">
        {posts.map((post) => (
          <li data-tags={post.data.tags.map(tagSlug).join(' ')}>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>
