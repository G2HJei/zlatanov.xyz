---
import { getPublishedPosts } from '../../collections';
import ButtonLink from '../../components/ButtonLink.astro';
import Card from '../../components/Card.astro';
import Hero from '../../components/Hero.astro';
import Icon from '../../components/Icon.astro';
import PostCard from '../../components/PostCard.astro';
import TagFilter from '../../components/TagFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tagSlug } from '../../lib/tags';

const posts = await getPublishedPosts();
---

<BaseLayout
  title="Blog"
  description="Notes on Java and Spring, test-driven development, domain-driven design and CI/CD, written from consulting engagements."
>
  <Hero title="Blog" subtitle="notes on Java, TDD, DDD and CI/CD" />

  <div class="space-y-8">
    <Card id="subscribe" title="subscribe" class="text-center">
      <p class="mx-auto max-w-2xl text-[1.1rem] text-ink-muted">
        Practical notes and case studies from real engagements, a few times a year. Point your feed
        reader at the RSS feed, or pick a tag to narrow the posts below.
      </p>
      <div class="mt-8 flex justify-center">
        <ButtonLink href="/rss.xml">
          <Icon name="rss" class="size-5" />
          RSS feed
        </ButtonLink>
      </div>
      <TagFilter posts={posts} class="mt-10" />
    </Card>

    <section id="posts" aria-labelledby="posts-heading">
      <h2
        id="posts-heading"
        class="mb-6 font-mono text-2xl font-semibold text-accent before:text-ink-faint before:content-['#_']"
      >
        posts
      </h2>
      {posts.length === 0 ? (
        <p class="font-mono text-ink-faint">No posts yet.</p>
      ) : (
        <ul class="grid gap-8">
          {posts.map((post) => (
            <li data-tags={post.data.tags.map(tagSlug).join(' ')}>
              <PostCard post={post} />
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</BaseLayout>
