---
import { getPublishedPosts } from '../../../collections';
import PageHeader from '../../../components/PageHeader.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { groupByTag, tagUrl } from '../../../lib/tags';

const groups = groupByTag(await getPublishedPosts());
---

<BaseLayout title="Tags" description="All blog post tags.">
  <div class="max-w-3xl pb-16 sm:pb-24">
    <PageHeader
      title="Tags"
      lead="Posts grouped by topic."
      back={{ href: '/blog/', label: 'Blog' }}
    />

    {groups.length === 0 ? (
      <p class="text-ink-muted">No tags yet.</p>
    ) : (
      <ul class="flex flex-wrap gap-2">
        {groups.map((group) => (
          <li>
            <a
              href={tagUrl(group.slug)}
              class="inline-flex items-center gap-2 rounded-full bg-surface-muted px-3 py-1.5 text-sm font-medium text-ink transition-colors hover:bg-accent/10 hover:text-accent"
            >
              {group.label}
              <span class="text-xs font-normal text-ink-muted">{group.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
