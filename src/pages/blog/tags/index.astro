---
import { getPublishedPosts } from '../../../collections';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { groupByTag, tagUrl } from '../../../lib/tags';

const groups = groupByTag(await getPublishedPosts());
---

<BaseLayout title="Tags" description="All blog post tags.">
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight">Tags</h1>
    <p class="mt-4 text-lg text-ink-muted">Posts grouped by topic.</p>

    {groups.length === 0 ? (
      <p class="mt-12 text-ink-muted">No tags yet.</p>
    ) : (
      <ul class="mt-12 flex flex-wrap gap-3">
        {groups.map((group) => (
          <li>
            <a
              href={tagUrl(group.slug)}
              class="inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-sm transition-colors hover:border-accent hover:text-accent"
            >
              {group.label}
              <span class="text-xs text-ink-muted">{group.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>
