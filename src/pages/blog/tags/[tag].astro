---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import { getPublishedPosts } from '../../../collections';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { groupByTag } from '../../../lib/tags';

export const getStaticPaths = (async () => {
  const groups = groupByTag(await getPublishedPosts());
  return groups.map((group) => ({ params: { tag: group.slug }, props: { group } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { group } = Astro.props;
const noun = group.count === 1 ? 'post' : 'posts';
---

<BaseLayout title={`Tag: ${group.label}`} description={`Blog posts tagged “${group.label}”.`}>
  <div class="max-w-3xl pb-16 sm:pb-24">
    <PageHeader
      title={group.label}
      lead={`${group.count} ${noun} tagged “${group.label}”.`}
      back={{ href: '/blog/tags/', label: 'All tags' }}
    />

    <ul class="divide-y divide-line border-t border-line">
      {group.posts.map((post) => (
        <li class="py-8">
          <PostCard post={post} />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
