---
import CTA from '../components/CTA.astro';
import Prose from '../components/Prose.astro';
import Section from '../components/Section.astro';
import { principles } from '../data/principles';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

// TODO: personalise the bio (years of experience, industries, notable systems, location) and
// prune the tool list to what you actually use.
const tools = [
  'Java 17 / 21',
  'Spring Boot',
  'JUnit 5',
  'Mockito',
  'Testcontainers',
  'ArchUnit',
  'Maven',
  'Gradle',
  'PostgreSQL',
  'Kafka',
  'Docker',
  'Kubernetes',
  'GitHub Actions',
  'GitLab CI',
];
---

<BaseLayout
  title="About"
  description={`About ${SITE.name}: independent Java consultant focused on test-driven development, domain-driven design and CI/CD.`}
>
  <div class="mx-auto max-w-3xl">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">About</h1>
    <Prose class="mt-8 text-lg">
      <p>
        I'm {SITE.name}, an independent software consultant. I work with teams that build and run
        Java systems, usually ones that have been in production for years and have to keep changing.
      </p>
      <p>
        Most of my career has been spent inside long-lived Spring codebases: adding features under
        pressure, untangling what earlier pressure left behind, and putting in place the tests and
        pipelines that stop the cycle from repeating. That is where my focus on test-driven
        development, domain-driven design and continuous delivery comes from. They are not ideals I
        read about; they are the practices that made the difference on real systems.
      </p>
      <p>
        As a consultant I do the work alongside your engineers rather than from the sidelines. I
        pair, I review, I write code, and I make sure the team can carry on without me.
      </p>
      <p>
        I write about these topics on the <a href="/blog/">blog</a> and share code on{' '}
        <a href={SITE.social.github} rel="me noopener">
          GitHub
        </a>
        .
      </p>
    </Prose>
  </div>

  <Section title="How I work">
    <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2">
      {principles.map((principle) => (
        <div>
          <dt class="font-semibold">{principle.title}</dt>
          <dd class="mt-2 text-ink-muted">{principle.text}</dd>
        </div>
      ))}
    </dl>
  </Section>

  <Section
    title="Tools I work with"
    lead="The everyday stack. I pick up whatever your system already uses."
  >
    <ul class="flex flex-wrap gap-2">
      {tools.map((tool) => (
        <li class="rounded-full border border-line px-3 py-1 text-sm text-ink-muted">{tool}</li>
      ))}
    </ul>
  </Section>

  <CTA title="Want to talk it through?" />
</BaseLayout>
